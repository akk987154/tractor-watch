# TractorWatch 配置
# 复制此文件为 .env 并填入实际值：  cp .env.example .env
#
# 注意：settings 使用 extra="forbid"，写错变量名会直接报错而不是被静默忽略。
# 这是刻意为之 —— 把 TELEGRAM_BOT_TOKEN 拼错成 TOCKEN 时，
# 原实现只会得到一个空 token，通知发不出去却没有任何提示。

# 数据库路径（目前仅支持 sqlite:/// 形式）
DATABASE_URL=sqlite:///tractor_watch.db

# Telegram 通知（可选，两项都填才会启用）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord 通知（可选）
# 必须是 https://discord.com/api/webhooks/... 形式的地址
DISCORD_WEBHOOK_URL=

# 检查间隔（小时），取值范围 1-168
CHECK_INTERVAL_HOURS=6

# 单条告警的最大通知重试次数（1-100）。
# 超过后停止重试，失败原因保留在 alerts.last_notify_error，
# 并计入 /health 的 alerts_failed。
MAX_NOTIFY_ATTEMPTS=5

# 是否开放 /docs 与 /openapi.json。
# API 目前没有鉴权，若不需要对外提供接口就设为 false。
ENABLE_DOCS=true

# User-Agent
USER_AGENT=TractorWatch/1.0 (tractor price tracker)
